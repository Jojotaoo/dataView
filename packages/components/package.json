{
  "name": "@demo/components",
  "version": "0.0.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "files": ["dist"],
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "types": "./dist/index.d.ts"
      },
      "./*": "./dist/*"
    }
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "echarts": "^6.0.0",
    "pinia": "^3.0.0"
  },
  "devDependencies": {
    "vue": "^3.5.35",
    "echarts": "^6.1.0",
    "pinia": "^3.0.4",
    "typescript": "~6.0.2"
  }
}
